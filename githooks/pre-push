#!/bin/bash
# Enforce the release gate on every push from this repo.
#
# Install (once per clone):  git config core.hooksPath githooks
#
# A gate nothing invokes is documentation, not a gate. This is the caller.
# Git feeds one line per ref on stdin:  <local ref> <local sha> <remote ref> <remote sha>
# The remote sha is what the gate needs: it is the commit the remote is actually
# at, which is the only honest base for "what am I about to publish".

set -u
ZERO="0000000000000000000000000000000000000000"
GATE="$(git rev-parse --show-toplevel)/scripts/release-gate.py"

[ -x "$GATE" ] || { echo "pre-push: release gate missing at $GATE" >&2; exit 1; }

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  # Deleting a remote ref publishes nothing.
  [ "$local_sha" = "$ZERO" ] && continue

  # A tag is a pointer, not a release of its target's tree. Rollback tags point
  # at deliberately OLDER states, which will fail checks that describe the
  # current release -- gating them would make the rollback affordance
  # unpublishable. Skip only when the target is already reachable from a remote
  # branch, i.e. it was gated when that branch was pushed; a tag on an unpushed
  # commit still carries new content and is gated normally.
  case "$remote_ref" in
    refs/tags/*)
      target=$(git rev-list -n1 "$local_sha" 2>/dev/null)
      if [ -n "$target" ] && [ -n "$(git branch -r --contains "$target" 2>/dev/null)" ]; then
        echo "pre-push: $remote_ref points at an already-published commit -- no new content"
        continue
      fi
      echo "pre-push: $remote_ref points at an unpublished commit -- gating it"
      ;;
  esac

  echo "pre-push: running release gate for $remote_ref"
  if ! "$GATE" --release --local-sha "$local_sha" --remote-sha "$remote_sha"; then
    echo "pre-push: BLOCKED -- $remote_ref not pushed" >&2
    status=1
  fi
done

[ "$status" -ne 0 ] && echo "pre-push: fix the findings above, or push with --no-verify only if you know why" >&2
exit "$status"
